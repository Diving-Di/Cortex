# Copy to .env and replace every value. Docker Compose intentionally has no password defaults.
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-long-random-password
POSTGRES_APP_PASSWORD=replace-with-a-different-long-random-password
LITELLM_MASTER_KEY=replace-with-a-random-sk-prefixed-gateway-key
LITELLM_DB_PASSWORD=replace-with-a-third-long-random-password
# Generate this with backend/scripts/provision-litellm-key.ps1 after the gateway starts.
LITELLM_VIRTUAL_KEY=replace-with-the-generated-virtual-key
OPENAI_API_KEY=replace-with-your-openai-key
KIMI_API_KEY=replace-with-your-kimi-key
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
LOCAL_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_EMBEDDING_API_KEY=ollama-local
RAG_EMBEDDING_SEND_DIMENSIONS=false
RAG_RERANK_BASE_URL=http://reranker-service:8080
RAG_RERANK_MIN_SCORE=0.5038954
RAG_MIN_QUALIFIED_EVIDENCE=1
REDIS_PASSWORD=replace-with-a-long-random-secret
APP_ENV=development
CORTEX_DATA_DIR=/app/data
KNOWLEDGE_MAX_UPLOAD_BYTES=268435456
KNOWLEDGE_MAX_EXTRACTED_BYTES=1073741824
KNOWLEDGE_MAX_FILE_BYTES=67108864
KNOWLEDGE_MAX_FILES=5000
KNOWLEDGE_MAX_DEPTH=16
KNOWLEDGE_MAX_COMPRESSION_RATIO=100
RESEARCH_ENABLED=true
RESEARCH_WORKERS=1
RESEARCH_MAX_KEYWORDS=5
RESEARCH_MAX_URLS=30
RESEARCH_MAX_RESULTS=50
RESEARCH_MAX_IMAGES=20
RESEARCH_MAX_IMAGE_BYTES=10485760
RESEARCH_MAX_BODY_CHARS=100000
RESEARCH_LEASE_SECONDS=300
RESEARCH_MAX_ATTEMPTS=3
RESEARCH_REQUEST_INTERVAL_MS=1500
RESEARCH_HTTP_TIMEOUT_SECONDS=20
# Optional internal OCR endpoint. Leave empty to retain images with OCR marked unavailable.
RESEARCH_OCR_URL=
# Per-tenant Xiaohongshu QR authorization. Generate the key with:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
XHS_AUTHORIZATION_ENABLED=false
XHS_AUTHORIZATION_TTL_SECONDS=180
XHS_SESSION_ENCRYPTION_KEY=
XHS_SESSION_KEY_VERSION=1
XHS_CHROME_PATH=/usr/bin/chromium
