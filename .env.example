# Copy to .env and replace every value. Docker Compose intentionally has no password defaults.
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-long-random-password
POSTGRES_APP_PASSWORD=replace-with-a-different-long-random-password
LITELLM_MASTER_KEY=replace-with-a-random-sk-prefixed-gateway-key
LITELLM_DB_PASSWORD=replace-with-a-third-long-random-password
# Generate this with backend/scripts/provision-litellm-key.ps1 after the gateway starts.
LITELLM_VIRTUAL_KEY=replace-with-the-generated-virtual-key
OPENAI_API_KEY=replace-with-your-openai-key
KIMI_API_KEY=replace-with-your-kimi-key
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
MINIO_ROOT_USER=replace-with-a-minio-administrator-name
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-administrator-password
MINIO_ACCESS_KEY=replace-with-a-minio-application-access-key
MINIO_SECRET_KEY=replace-with-a-long-random-minio-application-secret
ELASTICSEARCH_PASSWORD=replace-with-a-long-random-elasticsearch-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
# Local default keeps alerts inside Alertmanager. Production must point this to
# a reviewed receiver config (PagerDuty/Slack/webhook/email) and test delivery.
ALERTMANAGER_CONFIG_FILE=./deploy/alertmanager/alertmanager.yml
LOCAL_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_EMBEDDING_API_KEY=ollama-local
RAG_EMBEDDING_SEND_DIMENSIONS=false
RAG_RERANK_BASE_URL=http://reranker-service:8080
RAG_RERANK_MIN_SCORE=0.5038954
RAG_MIN_QUALIFIED_EVIDENCE=1
# Experimental and off by default. Obvious comparison/trend questions only;
# every request is capped at four subqueries and shares the request deadline.
RAG_PLANNER_ENABLED=false
RAG_PLANNER_MAX_SUBQUERIES=4
REDIS_PASSWORD=replace-with-a-long-random-secret
AI_EVENT_PROJECTION_BUILD_BATCH_SIZE=250
AI_EVENT_PROJECTION_BUILD_LEASE_SECONDS=60
APP_ENV=development
# Required by docker-compose.production.yml and rejected unless it is HTTPS.
PUBLIC_BASE_URL=https://cortex.example.com
CORS_ORIGINS=https://cortex.example.com
# Only enable when every request reaches the backend through the bundled or
# another trusted reverse proxy that overwrites (never appends) X-Forwarded-For.
TRUST_PROXY_HEADERS=true
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_REGISTER_IP_LIMIT=5
AUTH_TOKEN_IP_LIMIT=15
# all starts HTTP and background runners. Production may deploy separate api
# and worker processes; api never opens the migrator database connection.
CORTEX_RUNTIME_ROLE=all
CORTEX_DATA_DIR=/app/data
KNOWLEDGE_MAX_UPLOAD_BYTES=268435456
KNOWLEDGE_MAX_EXTRACTED_BYTES=1073741824
KNOWLEDGE_MAX_FILE_BYTES=67108864
KNOWLEDGE_MAX_FILES=5000
KNOWLEDGE_MAX_DEPTH=16
KNOWLEDGE_MAX_COMPRESSION_RATIO=100
# Binary knowledge ingestion is handled by the internal parser sidecar.
DOCUMENT_PARSER_TIMEOUT_SECONDS=120
