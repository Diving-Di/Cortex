{
  "name": "cortex-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "webpack serve --mode development",
    "prebuild": "node scripts/check-node-version.cjs",
    "build": "tsc --noEmit && webpack --mode production",
    "analyze": "npm run build -- --profile --json=stats.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/check-node-version.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "webpack serve --mode development"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@tanstack/react-query": "^5.66.0",
    "@uiw/react-codemirror": "^4.23.10",
    "antd": "^5.22.7",
    "axios": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.0.0",
    "react-router-dom": "^7.1.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^26.0.0",
    "prettier": "3.6.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  }
}
